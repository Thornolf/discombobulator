{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Discombobulator",
  "identifier": "com.thornolf.discombobulator",
  "build": {
    "frontendDist": "placeholder"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; connect-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "Discombobulator",
        "displayLanguageSelector": false,
        "compression": "lzma"
      }
    },
    "publisher": "Thornolf",
    "copyright": "Copyright (c) 2026 Thornolf. MIT License.",
    "category": "Photography",
    "shortDescription": "Fast, keyboard-first photo culling for Fujifilm RAF + JPG",
    "longDescription": "Cull Fujifilm RAF + JPG photos with one key per decision, hand picks to Lightroom through XMP sidecars, and swipe through them on an iPhone over Tailscale.",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZGRTQyQjgwMkZCNDJFRDMKUldUVExyUXZnQ3ZrLzEvUzZEM1BnNmpYODNGQTk5RWF1UlRjK0JUM29wYURuUndrTU5OUE5DaEQK",
      "endpoints": [
        "https://github.com/Thornolf/discombobulator/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "requireSignedVersion": true
    }
  }
}
